PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=https://your-game.example
TRUST_PROXY=1

# Per-client limit for issuing browser-bound profiles.
PROFILE_CREATION_RATE_LIMIT_MAX=10
PROFILE_CREATION_RATE_LIMIT_WINDOW_MS=600000

# Omit DATABASE_URL for disposable rooms, receipts, history, and profiles.
DATABASE_URL=postgresql://tic_tac_toe:change-me@127.0.0.1:5432/tic_tac_toe
DATABASE_SSL=disable
HISTORY_RETENTION_DAYS=365

# Use a generated secret in production. The browser keeps it in session storage.
ADMIN_API_KEY=replace-with-a-long-random-value

# Optional provider-neutral deployment labels for history events.
SERVICE_INSTANCE_ID=local
RELEASE_SHA=development
