{
  "name": "tic-tac-toe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,server --prefix-colors cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsup server/index.ts --format esm --platform node --target node20 --out-dir dist-server --clean --sourcemap",
    "start": "node dist-server/index.js",
    "lint": "oxlint --ignore-pattern 'dist/**' --ignore-pattern 'dist-server/**' --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:visual": "node scripts/visual-check.mjs",
    "check:online": "node scripts/online-check.mjs",
    "check:admin": "node scripts/admin-check.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.30.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.62.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
